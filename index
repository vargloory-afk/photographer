<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="description" content="Portofolio fotografi profesional Dadang Mulyadi — Wedding, Prewedding, Wisuda, Produk, Event.">
<meta name="author" content="Dadang Mulyadi">
<title>Dadang Mulyadi — Photographer & Visual Storyteller</title>

<!-- ============================================================
     FONT & ICON CDN
     ============================================================ -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;0,900;1,400;1,700&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
/* ============================================================
   1. RESET & GLOBAL VARIABLES
   ============================================================ */
*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* Color Palette */
    --primary:        #0f0f0f;
    --primary-soft:   #1a1a1a;
    --secondary:      #d4a548;
    --secondary-dark: #b88a2e;
    --accent:         #e85d3c;
    --text:           #1c1c1c;
    --text-soft:      #5a5a5a;
    --text-muted:     #8a8a8a;
    --light:          #f6f5f2;
    --light-2:        #efece6;
    --border:         #e2dfd8;
    --white:          #ffffff;

    /* Typography */
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body:    'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

    /* Layout */
    --container:     1280px;
    --container-wide: 1440px;
    --radius-sm:     6px;
    --radius:        12px;
    --radius-lg:     20px;

    /* Motion */
    --ease:      cubic-bezier(0.25, 0.8, 0.25, 1);
    --ease-out:  cubic-bezier(0.16, 1, 0.3, 1);
    --t-fast:    0.2s;
    --t-base:    0.35s;
    --t-slow:    0.7s;

    /* Navbar height — dipakai untuk scroll-padding */
    --nav-h: 84px;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--nav-h);
}

body {
    font-family: var(--font-body);
    color: var(--text);
    background: var(--white);
    line-height: 1.65;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

body.no-scroll { overflow: hidden; }

h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--primary);
}

p { color: var(--text-soft); }

a {
    color: inherit;
    text-decoration: none;
    transition: color var(--t-base) var(--ease);
}

img { max-width: 100%; display: block; }

ul, ol { list-style: none; }

button {
    font-family: inherit;
    border: none;
    background: none;
    cursor: pointer;
    color: inherit;
}

input, textarea, select {
    font-family: inherit;
    font-size: 15px;
}

::selection {
    background: var(--secondary);
    color: var(--white);
}

::-webkit-scrollbar { width: 10px; }
::-webkit-scrollbar-track { background: var(--light); }
::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: var(--secondary); }

/* ============================================================
   2. UTILITY CLASSES
   ============================================================ */
.container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 32px;
    width: 100%;
}

.section { padding: 110px 0; position: relative; }
.section--light { background: var(--light); }
.section--dark { background: var(--primary); color: var(--white); }
.section--dark h2, .section--dark h3 { color: var(--white); }
.section--dark p { color: rgba(255,255,255,0.72); }

.section-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 70px;
}

.section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--secondary);
    margin-bottom: 18px;
}

.section-eyebrow::before,
.section-eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--secondary);
}

.section-title {
    font-size: clamp(30px, 4.5vw, 54px);
    font-weight: 700;
    margin-bottom: 18px;
}

.section-title em {
    font-style: italic;
    color: var(--secondary);
    font-weight: 400;
}

.section-desc {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-muted);
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 34px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-radius: 0;
    transition: all var(--t-base) var(--ease);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid transparent;
    white-space: nowrap;
}

.btn i { transition: transform var(--t-base) var(--ease); }
.btn:hover i { transform: translateX(5px); }

.btn--primary {
    background: var(--primary);
    color: var(--white);
    border-color: var(--primary);
}
.btn--primary:hover {
    background: var(--secondary);
    border-color: var(--secondary);
    color: var(--white);
}

.btn--gold {
    background: var(--secondary);
    color: var(--white);
    border-color: var(--secondary);
}
.btn--gold:hover {
    background: transparent;
    color: var(--secondary);
}

.btn--outline {
    background: transparent;
    color: var(--primary);
    border-color: var(--primary);
}
.btn--outline:hover {
    background: var(--primary);
    color: var(--white);
}

.btn--light {
    background: transparent;
    color: var(--white);
    border-color: rgba(255,255,255,0.4);
}
.btn--light:hover {
    background: var(--white);
    color: var(--primary);
    border-color: var(--white);
}

/* ============================================================
   3. PRELOADER
   ============================================================ */
#preloader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    transition: opacity 0.8s var(--ease-out), visibility 0.8s;
}

#preloader.loaded {
    opacity: 0;
    visibility: hidden;
}

.preloader-inner { text-align: center; color: var(--white); }

.preloader-logo {
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 900;
    letter-spacing: 0.15em;
    margin-bottom: 22px;
    opacity: 0;
    animation: preloadFade 1s var(--ease-out) 0.2s forwards;
}

.preloader-logo span { color: var(--secondary); }

@keyframes preloadFade { to { opacity: 1; } }

.preloader-bar {
    width: 220px;
    height: 2px;
    background: rgba(255,255,255,0.15);
    margin: 0 auto 16px;
    overflow: hidden;
    position: relative;
}

.preloader-bar::after {
    content: '';
    position: absolute;
    top: 0; left: -40%;
    width: 40%;
    height: 100%;
    background: var(--secondary);
    animation: preloadBar 1.4s ease-in-out infinite;
}

@keyframes preloadBar {
    0%   { left: -40%; }
    100% { left: 100%; }
}

.preloader-text {
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
}

/* ============================================================
   4. SCROLL PROGRESS BAR
   ============================================================ */
#scrollProgress {
    position: fixed;
    top: 0; left: 0;
    height: 3px;
    width: 0%;
    background: linear-gradient(90deg, var(--secondary), var(--accent));
    z-index: 9999;
    transition: width 0.1s linear;
}

/* ============================================================
   5. NAVBAR
   ============================================================ */
.navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 900;
    padding: 22px 0;
    background: transparent;
    transition: all var(--t-base) var(--ease);
}

.navbar.scrolled {
    padding: 12px 0;
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 rgba(0,0,0,0.06), 0 8px 32px rgba(0,0,0,0.04);
}

.navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.nav-brand {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 0.02em;
    color: var(--white);
    transition: color var(--t-base) var(--ease);
    line-height: 1;
    flex-shrink: 0;
}

.navbar.scrolled .nav-brand { color: var(--primary); }
.nav-brand span { color: var(--secondary); }

.nav-menu {
    display: flex;
    align-items: center;
    gap: 38px;
}

.nav-link {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    position: relative;
    padding: 6px 0;
    transition: color var(--t-base) var(--ease);
    white-space: nowrap;
}

.navbar.scrolled .nav-link { color: var(--text-soft); }

.nav-link::after {
    content: '';
    position: absolute;
    left: 0; bottom: 0;
    width: 0;
    height: 1.5px;
    background: var(--secondary);
    transition: width var(--t-base) var(--ease);
}

.nav-link:hover, .nav-link.active { color: var(--secondary); }
.nav-link:hover::after, .nav-link.active::after { width: 100%; }

.nav-cta {
    padding: 12px 24px !important;
    font-size: 11px !important;
}

.navbar.scrolled .nav-cta.btn--light {
    border-color: var(--primary);
    color: var(--primary);
}
.navbar.scrolled .nav-cta.btn--light:hover {
    background: var(--primary);
    color: var(--white);
}

.nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: var(--white);
    transition: color var(--t-base) var(--ease);
}

.navbar.scrolled .nav-toggle { color: var(--primary); }

/* Mobile Menu */
.mobile-menu {
    position: fixed;
    inset: 0;
    background: var(--primary);
    z-index: 950;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--t-base) var(--ease), visibility var(--t-base);
}

.mobile-menu.open { opacity: 1; visibility: visible; }

.mobile-menu a {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 500;
    color: var(--white);
    padding: 12px 30px;
    transition: color var(--t-base) var(--ease);
    transform: translateY(20px);
    opacity: 0;
}

.mobile-menu.open a {
    transform: translateY(0);
    opacity: 1;
}

.mobile-menu.open a:nth-child(1) { transition: all 0.4s var(--ease-out) 0.10s; }
.mobile-menu.open a:nth-child(2) { transition: all 0.4s var(--ease-out) 0.15s; }
.mobile-menu.open a:nth-child(3) { transition: all 0.4s var(--ease-out) 0.20s; }
.mobile-menu.open a:nth-child(4) { transition: all 0.4s var(--ease-out) 0.25s; }
.mobile-menu.open a:nth-child(5) { transition: all 0.4s var(--ease-out) 0.30s; }
.mobile-menu.open a:nth-child(6) { transition: all 0.4s var(--ease-out) 0.35s; }

.mobile-menu a:hover { color: var(--secondary); }

.mobile-menu-close {
    position: absolute;
    top: 24px; right: 24px;
    width: 48px; height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: var(--white);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%;
    transition: all var(--t-base) var(--ease);
}

.mobile-menu-close:hover {
    background: var(--secondary);
    border-color: var(--secondary);
}

/* ============================================================
   6. HERO — DESKTOP FIT ONE SCREEN
   ============================================================ */

/* 
   Kunci utama: hero pakai min-height 100vh + min-height fallback,
   konten dibungkus grid 2 kolom di desktop, dan semua font pakai
   clamp() supaya tidak overflow di zoom-out.
*/
.hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;   /* small viewport — aman untuk mobile browser */
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background: var(--primary);
    padding: calc(var(--nav-h) + 20px) 0 40px;
}

.hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 1;
    opacity: 0.55;
    animation: heroZoom 22s ease-in-out infinite alternate;
    will-change: transform;
}

@keyframes heroZoom {
    from { transform: scale(1); }
    to   { transform: scale(1.1); }
}

.hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
        linear-gradient(180deg, rgba(15,15,15,0.55) 0%, rgba(15,15,15,0.7) 55%, rgba(15,15,15,0.95) 100%),
        radial-gradient(ellipse at 25% 35%, rgba(212,165,72,0.14), transparent 55%);
}

.hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 32px;
}

/* 
   Grid 2 kolom: kiri teks informatif, kanan highlight/quick info.
   Di mobile jadi 1 kolom.
*/
.hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 60px;
    align-items: center;
}

.hero-content { color: var(--white); }

.hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--secondary);
    margin-bottom: 28px;
    opacity: 0;
    animation: heroFade 1s var(--ease-out) 0.3s forwards;
}

.hero-eyebrow .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--secondary);
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
}

@keyframes pulse {
    0%, 100% { transform: scale(1);   opacity: 1; }
    50%      { transform: scale(1.5); opacity: 0.5; }
}

.hero-title {
    /* clamp 3 nilai: min, ideal vw, max — supaya proporsional di semua zoom */
    font-size: clamp(38px, 5.2vw, 82px);
    font-weight: 900;
    line-height: 1.02;
    margin-bottom: 24px;
    color: var(--white);
    letter-spacing: -0.025em;
    opacity: 0;
    animation: heroFade 1.2s var(--ease-out) 0.5s forwards;
}

.hero-title em {
    display: block;
    font-style: italic;
    font-weight: 400;
    color: var(--secondary);
    font-size: 0.85em;
    margin-top: 6px;
}

.hero-desc {
    font-size: clamp(15px, 1.15vw, 18px);
    font-weight: 300;
    line-height: 1.75;
    color: rgba(255,255,255,0.78);
    max-width: 560px;
    margin-bottom: 34px;
    opacity: 0;
    animation: heroFade 1.2s var(--ease-out) 0.7s forwards;
}

.hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    opacity: 0;
    animation: heroFade 1.2s var(--ease-out) 0.9s forwards;
}

@keyframes heroFade {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* 
   KANAN: kartu quick info — "kata-kata informatif"
   Menampilkan layanan unggulan + kontak cepat.
*/
.hero-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: var(--radius);
    padding: 36px 32px;
    color: var(--white);
    opacity: 0;
    animation: heroFade 1.2s var(--ease-out) 0.7s forwards;
}

.hero-card-title {
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--secondary);
    font-weight: 700;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.hero-card-title i { font-size: 13px; }

.hero-card-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 24px;
}

.hero-card-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    font-size: 14px;
}

.hero-card-list li:last-child { border-bottom: none; }

.hero-card-list .label {
    display: flex;
    align-items: center;
    gap: 12px;
    color: rgba(255,255,255,0.85);
    font-weight: 400;
}

.hero-card-list .label i {
    width: 30px;
    height: 30px;
    background: rgba(212,165,72,0.15);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: var(--secondary);
    flex-shrink: 0;
}

.hero-card-list .value {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--secondary);
}

.hero-card-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,0.12);
}

.hero-card-cta .price-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    font-weight: 600;
    display: block;
    margin-bottom: 2px;
}

.hero-card-cta .price-value {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--white);
}

.hero-card-cta a {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--secondary);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: all var(--t-base) var(--ease);
    flex-shrink: 0;
}

.hero-card-cta a:hover {
    background: var(--white);
    color: var(--primary);
    transform: rotate(-45deg);
}

/* HERO STATS — 4 kolom di bawah */
.hero-stats {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    max-width: var(--container-wide);
    margin: 60px auto 0;
    padding: 30px 32px 0;
    border-top: 1px solid rgba(255,255,255,0.1);
    opacity: 0;
    animation: heroFade 1.2s var(--ease-out) 1.1s forwards;
}

.hero-stat { color: var(--white); text-align: left; }

.hero-stat-num {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.2vw, 46px);
    font-weight: 700;
    color: var(--secondary);
    line-height: 1;
    margin-bottom: 8px;
}

.hero-stat-label {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    font-weight: 500;
}

/* Scroll Hint */
.scroll-hint {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    color: rgba(255,255,255,0.5);
    font-size: 10px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: heroFade 1.2s var(--ease-out) 1.5s forwards;
}

.scroll-hint i {
    font-size: 13px;
    animation: scrollBounce 2s ease-in-out infinite;
}

@keyframes scrollBounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(8px); }
}

/* ============================================================
   7. MARQUEE STRIP
   ============================================================ */
.marquee {
    background: var(--secondary);
    padding: 20px 0;
    overflow: hidden;
    position: relative;
}

.marquee-track {
    display: flex;
    gap: 60px;
    animation: marquee 32s linear infinite;
    white-space: nowrap;
    width: max-content;
}

.marquee-item {
    display: flex;
    align-items: center;
    gap: 60px;
    font-family: var(--font-display);
    font-size: 22px;
    font-style: italic;
    font-weight: 500;
    color: var(--primary);
}

.marquee-item i { font-size: 13px; opacity: 0.5; }

@keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
}

/* ============================================================
   8. ABOUT
   ============================================================ */
.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.about-visual { position: relative; }

.about-img-main {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    border-radius: var(--radius);
}

.about-img-main img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
}

.about-img-main:hover img { transform: scale(1.06); }

.about-img-secondary {
    position: absolute;
    bottom: -40px;
    right: -40px;
    width: 55%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 8px solid var(--white);
    border-radius: var(--radius);
    box-shadow: 0 24px 60px rgba(0,0,0,0.14);
}

.about-img-secondary img {
    width: 100%; height: 100%;
    object-fit: cover;
}

.about-badge {
    position: absolute;
    top: 30px;
    left: -30px;
    background: var(--secondary);
    color: var(--white);
    padding: 20px 26px;
    border-radius: var(--radius);
    text-align: center;
    box-shadow: 0 24px 60px rgba(0,0,0,0.14);
    animation: floatY 4s ease-in-out infinite;
}

@keyframes floatY {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-12px); }
}

.about-badge .num {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 900;
    line-height: 1;
    display: block;
}

.about-badge .label {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    margin-top: 4px;
}

.about-content h2 {
    font-size: clamp(30px, 4vw, 50px);
    margin-bottom: 24px;
    line-height: 1.1;
}

.about-content h2 em {
    color: var(--secondary);
    font-style: italic;
    font-weight: 400;
}

.about-lead {
    font-size: 18px;
    line-height: 1.75;
    color: var(--text);
    margin-bottom: 22px;
    font-weight: 400;
}

.about-content p {
    font-size: 15.5px;
    line-height: 1.8;
    margin-bottom: 18px;
}

.about-signature {
    font-family: var(--font-display);
    font-size: 28px;
    font-style: italic;
    color: var(--primary);
    margin: 30px 0 10px;
}

.about-role {
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--secondary);
    font-weight: 600;
    margin-bottom: 32px;
}

.about-socials {
    display: flex;
    gap: 12px;
    margin-top: 30px;
}

.about-socials a {
    width: 44px; height: 44px;
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-soft);
    font-size: 15px;
    transition: all var(--t-base) var(--ease);
}

.about-socials a:hover {
    background: var(--secondary);
    border-color: var(--secondary);
    color: var(--white);
    transform: translateY(-3px);
}

/* Skill Bars */
.skills { margin-top: 40px; }
.skill { margin-bottom: 20px; }

.skill-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--primary);
}

.skill-bar {
    height: 4px;
    background: var(--border);
    border-radius: 4px;
    overflow: hidden;
}

.skill-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--secondary), var(--accent));
    width: 0;
    transition: width 1.4s var(--ease-out);
    border-radius: 4px;
}

/* ============================================================
   9. SERVICES
   ============================================================ */
.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
}

.service-card {
    background: var(--white);
    border: 1px solid var(--border);
    padding: 44px 34px;
    position: relative;
    transition: all var(--t-base) var(--ease);
    overflow: hidden;
}

.service-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 3px;
    background: var(--secondary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-base) var(--ease);
}

.service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 24px 60px rgba(0,0,0,0.14);
    border-color: transparent;
}

.service-card:hover::before { transform: scaleX(1); }

.service-icon {
    width: 64px;
    height: 64px;
    background: var(--light);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    color: var(--secondary);
    margin-bottom: 26px;
    transition: all var(--t-base) var(--ease);
}

.service-card:hover .service-icon {
    background: var(--secondary);
    color: var(--white);
    transform: rotate(-6deg) scale(1.05);
}

.service-card h3 {
    font-size: 22px;
    margin-bottom: 12px;
}

.service-card p {
    font-size: 14.5px;
    line-height: 1.75;
    margin-bottom: 20px;
}

.service-card .price {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--secondary);
    font-weight: 700;
    padding: 6px 14px;
    background: rgba(212,165,72,0.1);
    border-radius: 20px;
}

/* ============================================================
   10. PORTFOLIO
   ============================================================ */
.portfolio-filter {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 50px;
}

.filter-btn {
    padding: 10px 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-soft);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 40px;
    transition: all var(--t-base) var(--ease);
}

.filter-btn:hover {
    border-color: var(--secondary);
    color: var(--secondary);
}

.filter-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--white);
}

.portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
}

.portfolio-item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    cursor: pointer;
    background: var(--light);
    border-radius: var(--radius-sm);
}

.portfolio-item.hide { display: none; }

.portfolio-item img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
}

.portfolio-item:hover img { transform: scale(1.1); }

.portfolio-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15,15,15,0.9), rgba(15,15,15,0.2) 55%, transparent);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 30px;
    color: var(--white);
}

.portfolio-item:hover .portfolio-overlay { opacity: 1; }

.portfolio-overlay .cat {
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--secondary);
    font-weight: 600;
    margin-bottom: 8px;
    transform: translateY(15px);
    transition: transform var(--t-base) var(--ease) 0.05s;
}

.portfolio-overlay h4 {
    font-size: 22px;
    color: var(--white);
    transform: translateY(15px);
    transition: transform var(--t-base) var(--ease) 0.1s;
}

.portfolio-overlay .view-icon {
    position: absolute;
    top: 24px; right: 24px;
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    font-size: 14px;
    transform: scale(0) rotate(-90deg);
    transition: transform var(--t-base) var(--ease) 0.15s;
}

.portfolio-item:hover .portfolio-overlay .cat,
.portfolio-item:hover .portfolio-overlay h4 { transform: translateY(0); }

.portfolio-item:hover .portfolio-overlay .view-icon {
    transform: scale(1) rotate(0deg);
}

/* ============================================================
   11. COUNTERS
   ============================================================ */
.counters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 40px;
    text-align: center;
}

.counter-item { color: var(--white); }

.counter-num {
    font-family: var(--font-display);
    font-size: clamp(44px, 5vw, 60px);
    font-weight: 700;
    color: var(--secondary);
    line-height: 1;
    margin-bottom: 10px;
}

.counter-label {
    font-size: 12px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    font-weight: 500;
}

/* ============================================================
   12. TESTIMONIALS
   ============================================================ */
.testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
}

.testimonial {
    background: var(--white);
    border: 1px solid var(--border);
    padding: 40px 34px;
    position: relative;
    transition: all var(--t-base) var(--ease);
    border-radius: var(--radius);
}

.testimonial:hover {
    box-shadow: 0 24px 60px rgba(0,0,0,0.14);
    transform: translateY(-6px);
    border-color: transparent;
}

.testimonial-quote {
    position: absolute;
    top: 20px; right: 30px;
    font-family: var(--font-display);
    font-size: 90px;
    line-height: 1;
    color: var(--secondary);
    opacity: 0.15;
    pointer-events: none;
}

.testimonial-stars {
    color: var(--secondary);
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 18px;
}

.testimonial-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 17px;
    line-height: 1.7;
    color: var(--text);
    margin-bottom: 26px;
    position: relative;
    z-index: 1;
}

.testimonial-author {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
}

.testimonial-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
}

.testimonial-avatar img {
    width: 100%; height: 100%;
    object-fit: cover;
}

.testimonial-info strong {
    display: block;
    font-size: 15px;
    color: var(--primary);
    font-weight: 700;
    margin-bottom: 2px;
    font-family: var(--font-body);
}

.testimonial-info span {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

/* ============================================================
   13. PROCESS
   ============================================================ */
.process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 30px;
    position: relative;
}

.process-step {
    text-align: center;
    padding: 30px 20px;
    position: relative;
}

.process-step-num {
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 900;
    line-height: 1;
    color: var(--secondary);
    opacity: 0.15;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
}

.process-icon {
    width: 72px;
    height: 72px;
    background: var(--white);
    border: 2px solid var(--secondary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    color: var(--secondary);
    margin: 20px auto 24px;
    position: relative;
    z-index: 1;
    transition: all var(--t-base) var(--ease);
}

.process-step:hover .process-icon {
    background: var(--secondary);
    color: var(--white);
    transform: rotate(360deg);
}

.process-step h4 { font-size: 20px; margin-bottom: 12px; }
.process-step p { font-size: 14px; line-height: 1.7; }

/* ============================================================
   14. CTA BANNER
   ============================================================ */
.cta-banner {
    position: relative;
    padding: 100px 0;
    background: var(--primary);
    overflow: hidden;
    text-align: center;
}

.cta-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=1600&q=80') center/cover;
    opacity: 0.22;
}

.cta-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(15,15,15,0.85), rgba(15,15,15,0.6));
}

.cta-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    margin: 0 auto;
    color: var(--white);
}

.cta-content h2 {
    font-size: clamp(30px, 4.5vw, 54px);
    color: var(--white);
    margin-bottom: 20px;
}

.cta-content h2 em {
    color: var(--secondary);
    font-style: italic;
    font-weight: 400;
}

.cta-content p {
    font-size: 17px;
    color: rgba(255,255,255,0.72);
    margin-bottom: 36px;
    line-height: 1.7;
}

/* ============================================================
   15. CONTACT / BOOKING FORM
   ============================================================ */
.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: start;
}

.contact-info h3 {
    font-size: 32px;
    margin-bottom: 20px;
}

.contact-info h3 em {
    color: var(--secondary);
    font-style: italic;
    font-weight: 400;
}

.contact-info > p {
    font-size: 15.5px;
    line-height: 1.8;
    margin-bottom: 36px;
}

.contact-list {
    display: flex;
    flex-direction: column;
    gap: 22px;
}

.contact-item {
    display: flex;
    gap: 18px;
    align-items: flex-start;
}

.contact-item-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    background: var(--light);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: var(--secondary);
    transition: all var(--t-base) var(--ease);
}

.contact-item:hover .contact-item-icon {
    background: var(--secondary);
    color: var(--white);
}

.contact-item-body { padding-top: 4px; }

.contact-item-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 4px;
}

.contact-item-value {
    font-size: 15.5px;
    color: var(--primary);
    font-weight: 500;
}

.contact-form {
    background: var(--white);
    padding: 44px 40px;
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    border: 1px solid var(--border);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.form-group { margin-bottom: 22px; }

.form-group label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 10px;
}

.form-group label .req { color: var(--accent); }

.form-control {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--border);
    background: var(--light);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 15px;
    transition: all var(--t-base) var(--ease);
}

.form-control:focus {
    outline: none;
    border-color: var(--secondary);
    background: var(--white);
    box-shadow: 0 0 0 4px rgba(212,165,72,0.1);
}

textarea.form-control { min-height: 130px; resize: vertical; }

.form-submit {
    width: 100%;
    padding: 18px;
    background: var(--primary);
    color: var(--white);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    transition: all var(--t-base) var(--ease);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
}

.form-submit:hover {
    background: var(--secondary);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(212,165,72,0.35);
}

/* ============================================================
   16. FAQ
   ============================================================ */
.faq-list { max-width: 860px; margin: 0 auto; }

.faq-item { border-bottom: 1px solid var(--border); }

.faq-question {
    width: 100%;
    padding: 26px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    text-align: left;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    color: var(--primary);
    transition: color var(--t-base) var(--ease);
}

.faq-question:hover { color: var(--secondary); }

.faq-icon {
    width: 36px; height: 36px;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: var(--secondary);
    transition: all var(--t-base) var(--ease);
}

.faq-item.open .faq-icon {
    background: var(--secondary);
    border-color: var(--secondary);
    color: var(--white);
    transform: rotate(180deg);
}

.faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--t-base) var(--ease);
}

.faq-answer p { padding: 0 60px 26px 0; font-size: 15px; line-height: 1.8; }

/* ============================================================
   17. INSTAGRAM GRID
   ============================================================ */
.ig-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
}

.ig-item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    cursor: pointer;
}

.ig-item img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform var(--t-base) var(--ease);
}

.ig-item:hover img { transform: scale(1.1); }

.ig-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15,15,15,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    font-size: 24px;
    opacity: 0;
    transition: opacity var(--t-base) var(--ease);
}

.ig-item:hover .ig-overlay { opacity: 1; }

/* ============================================================
   18. FOOTER
   ============================================================ */
.footer {
    background: var(--primary);
    color: var(--white);
    padding: 90px 0 30px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: 50px;
    padding-bottom: 60px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}

.footer-brand h3 {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 900;
    letter-spacing: 0.02em;
    color: var(--white);
    margin-bottom: 18px;
}

.footer-brand h3 span { color: var(--secondary); }

.footer-brand p {
    font-size: 14.5px;
    line-height: 1.75;
    color: rgba(255,255,255,0.6);
    margin-bottom: 24px;
    max-width: 340px;
}

.footer-col h4 {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: 24px;
}

.footer-col ul li { margin-bottom: 12px; }

.footer-col ul a {
    color: rgba(255,255,255,0.6);
    font-size: 14.5px;
    transition: all var(--t-base) var(--ease);
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.footer-col ul a:hover {
    color: var(--secondary);
    transform: translateX(4px);
}

.footer-newsletter p {
    font-size: 14.5px;
    color: rgba(255,255,255,0.6);
    line-height: 1.75;
    margin-bottom: 18px;
}

.newsletter-form {
    display: flex;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.newsletter-form input {
    flex: 1;
    padding: 14px 16px;
    background: transparent;
    border: none;
    color: var(--white);
    font-size: 14px;
    min-width: 0;
}

.newsletter-form input::placeholder { color: rgba(255,255,255,0.35); }
.newsletter-form input:focus { outline: none; }

.newsletter-form button {
    padding: 0 20px;
    background: var(--secondary);
    color: var(--white);
    font-size: 14px;
    transition: background var(--t-base) var(--ease);
    flex-shrink: 0;
}

.newsletter-form button:hover { background: var(--secondary-dark); }

.footer-socials {
    display: flex;
    gap: 10px;
    margin-top: 22px;
}

.footer-socials a {
    width: 42px; height: 42px;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    color: rgba(255,255,255,0.7);
    transition: all var(--t-base) var(--ease);
}

.footer-socials a:hover {
    background: var(--secondary);
    border-color: var(--secondary);
    color: var(--white);
    transform: translateY(-4px);
}

.footer-bottom {
    padding-top: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 13px;
    color: rgba(255,255,255,0.45);
}

.footer-bottom a { color: rgba(255,255,255,0.6); }
.footer-bottom a:hover { color: var(--secondary); }

/* ============================================================
   19. FLOATING BUTTONS
   ============================================================ */
#backToTop,
.whatsapp-float {
    position: fixed;
    right: 24px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    z-index: 800;
    cursor: pointer;
    transition: all var(--t-base) var(--ease);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
}

#backToTop {
    bottom: 90px;
    background: var(--primary);
    color: var(--white);
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
}

#backToTop.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

#backToTop:hover {
    background: var(--secondary);
    transform: translateY(-4px);
}

.whatsapp-float {
    bottom: 24px;
    background: #25D366;
    color: var(--white);
    animation: waPulse 2.4s ease-in-out infinite;
}

.whatsapp-float:hover {
    transform: scale(1.1);
    animation-play-state: paused;
}

@keyframes waPulse {
    0%, 100% { box-shadow: 0 8px 24px rgba(37,211,102,0.3), 0 0 0 0 rgba(37,211,102,0.5); }
    50%      { box-shadow: 0 8px 24px rgba(37,211,102,0.4), 0 0 0 14px rgba(37,211,102,0); }
}

/* ============================================================
   20. SCROLL REVEAL
   ============================================================ */
.reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
}

.reveal.visible { opacity: 1; transform: translateY(0); }

.reveal-left  { transform: translateX(-50px); }
.reveal-right { transform: translateX(50px); }
.reveal-scale { transform: scale(0.92); }

.reveal-left.visible,
.reveal-right.visible,
.reveal-scale.visible {
    transform: translate(0) scale(1);
}

.stagger > * {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
}

.stagger.visible > * { opacity: 1; transform: translateY(0); }

.stagger.visible > *:nth-child(1) { transition-delay: 0.05s; }
.stagger.visible > *:nth-child(2) { transition-delay: 0.15s; }
.stagger.visible > *:nth-child(3) { transition-delay: 0.25s; }
.stagger.visible > *:nth-child(4) { transition-delay: 0.35s; }
.stagger.visible > *:nth-child(5) { transition-delay: 0.45s; }
.stagger.visible > *:nth-child(6) { transition-delay: 0.55s; }

